# Copiar a terraform.tfvars y ajustar. NO incluir secretos ni credenciales.
aws_region     = "us-east-1"
project_prefix = "dcl-dev"
project_tag    = "digital-cafe-luna"
environment    = "dev"
owner_team     = "team-01"

# Direccionamiento del diagrama del Hito 2
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
compute_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]
data_subnet_cidrs    = ["10.0.100.0/24", "10.0.200.0/24"]
single_nat_gateway   = false # true = ahorro FinOps (1 NAT), pierde redundancia de salida por AZ

# DNS / TLS
enable_route53      = true
domain_name         = "digitalcafeluna-grupo1.com"
acm_certificate_arn = "" # ARN de certificado ACM validado para habilitar HTTPS 443

# Cómputo
instance_type        = "t3.micro"
app_port             = 8080
asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4

# Base de datos
db_engine_version = "16"
db_instance_class = "db.t3.micro"

# Observabilidad / FinOps
alert_email        = "" # ej. "equipo@eafit.edu.co" para SNS y Budgets
monthly_budget_usd = 20
